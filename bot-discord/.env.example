# ============================================================
#  Réglages du bot Ruche & Outils — copie ce fichier en « .env »
# ============================================================

# --- Discord (obligatoire) ---------------------------------------------
# Portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=
# Portail développeur > ton application > General Information > Application ID
DISCORD_CLIENT_ID=
# (facultatif) l'identifiant de ton serveur Discord : les commandes y
# apparaissent tout de suite. Sans lui, elles sont publiées partout et
# Discord peut mettre jusqu'à une heure à les afficher.
DISCORD_GUILD_ID=

# --- Dashboard (Supabase) ---------------------------------------------
# Pour piloter le bot depuis dashboard.html sur le site. Mêmes projet que
# la connexion du site. Supabase ▸ Settings ▸ API Keys :
#   SUPABASE_URL        : l'adresse du projet (https://….supabase.co)
#   SUPABASE_CLE_SECRETE: la « Secret key » (sb_secret_…). ⚠️ Elle donne tous
#                         les droits : ne la mets JAMAIS sur le site ni sur GitHub.
# Sans ces deux lignes, le bot marche quand même, mais sans dashboard.
SUPABASE_URL=https://tbgiuzatulactsvwjljq.supabase.co
SUPABASE_CLE_SECRETE=
# (facultatif) autres comptes Discord autorisés à ouvrir le dashboard,
# séparés par des virgules. Le propriétaire du bot est ajouté tout seul.
DASHBOARD_ADMINS=

# --- Site --------------------------------------------------------------
SITE_URL=https://faucheuselamort.github.io/Hub-Fan-Bee-Swarm-Simulator
# toutes les combien de minutes le bot relit le site
SITE_RAFRAICHIR_MIN=60

# --- IA extérieure (facultatif) ----------------------------------------
# Le bot a déjà sa propre IA (Ruche IA), entraînée sur le site : rien à
# configurer. Une IA extérieure peut en plus rédiger des réponses libres.
#   aucune     : Ruche IA seule (conseillé)
#   anthropic  : Claude (clé sur console.anthropic.com)
#   openai     : tout service « compatible OpenAI » : Groq, Gemini, Mistral,
#                OpenRouter, OpenAI, ou Ollama installé sur ton PC
IA_FOURNISSEUR=aucune
IA_CLE=
# Modèle à utiliser. Exemples :
#   anthropic : claude-haiku-5-5
#   Groq      : llama-3.3-70b-versatile
#   Gemini    : gemini-2.5-flash
#   Ollama    : llama3.1
IA_MODELE=
# Adresse du service, seulement pour IA_FOURNISSEUR=openai. Exemples :
#   Groq   : https://api.groq.com/openai/v1
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama : http://localhost:11434/v1
IA_URL=

# --- Salon questions-réponses -----------------------------------------
# secondes d'attente entre deux questions d'un même membre
QUESTION_DELAI_S=8
